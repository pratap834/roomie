generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum EmployeeRole {
  ADMIN
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoomStatus {
  AVAILABLE
  UNAVAILABLE
  MAINTENANCE
}

enum RoomType {
  CONFERENCE
  BOARDROOM
  TRAINING
  PHONE_BOOTH
  COLLABORATION
  EXECUTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum EmergencyPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EmergencyStatus {
  OPEN
  IN_REVIEW
  APPROVED
  REJECTED
  RESOLVED
  CLOSED
}

enum EmergencyAction {
  KEEP_BOOKING
  ROOM_TRANSFER
  RESCHEDULE
  REDUCE_DURATION
  CONTACT_EMPLOYEE
}

enum EmailType {
  BOOKING_CONFIRMATION
  BOOKING_APPROVAL
  BOOKING_REJECTION
  BOOKING_CANCELLATION
  BOOKING_RESCHEDULED
  BOOKING_REMINDER
  EMERGENCY_CREATED
  EMERGENCY_APPROVED
  EMERGENCY_REJECTED
  EMERGENCY_RESOLVED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

enum BookingHistoryAction {
  CREATED
  UPDATED
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  RESCHEDULED
  EMERGENCY_REQUESTED
  EMERGENCY_KEPT
  ROOM_TRANSFERRED
  DURATION_REDUCED
}

enum BookingPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────

model Employee {
  id          String         @id @default(uuid())
  clerkId     String         @unique
  email       String         @unique
  firstName   String
  lastName    String
  department  String?
  jobTitle    String?
  phone       String?
  avatarUrl   String?
  role        EmployeeRole   @default(EMPLOYEE)
  status      EmployeeStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  bookings         Booking[]         @relation("EmployeeBookings")
  emergencyRequests EmergencyRequest[] @relation("EmployeeEmergencies")
  emergencyDecisions EmergencyRequest[] @relation("EmergencyDecisions")
  emailLogs        EmailLog[]
  bookingHistories BookingHistory[]

  @@index([clerkId])
  @@index([email])
  @@index([status])
  @@index([role])
  @@index([deletedAt])
  @@map("employees")
}

model Room {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  description  String?
  floor        Int
  building     String?
  capacity     Int
  type         RoomType   @default(CONFERENCE)
  status       RoomStatus @default(AVAILABLE)
  amenities    String[]
  imageUrl     String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  bookings          Booking[]
  emergencyRequests EmergencyRequest[]
  emergencyTransfers EmergencyRequest[] @relation("EmergencyTransferRoom")

  @@index([status])
  @@index([type])
  @@index([capacity])
  @@index([isActive])
  @@index([floor])
  @@map("rooms")
}

model Booking {
  id           String        @id @default(uuid())
  title        String
  description  String?
  startTime    DateTime
  endTime      DateTime
  date         DateTime      @db.Date
  attendeeCount Int
  priority     BookingPriority @default(MEDIUM)
  status       BookingStatus @default(CONFIRMED)
  notes        String?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  cancelledAt  DateTime?
  completedAt  DateTime?
  rejectionReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  employeeId   String
  employee     Employee      @relation("EmployeeBookings", fields: [employeeId], references: [id], onDelete: Restrict)
  roomId       String
  room         Room          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  approvedById String?

  emailLogs    EmailLog[]
  history      BookingHistory[]
  emergencyRequests EmergencyRequest[]

  @@index([employeeId])
  @@index([roomId])
  @@index([status])
  @@index([date])
  @@index([startTime, endTime])
  @@index([createdAt])
  @@index([roomId, date, status])
  @@map("bookings")
}

model EmergencyRequest {
  id           String            @id @default(uuid())
  subject      String
  description  String
  department   String?
  requestedStartTime DateTime?
  requestedEndTime   DateTime?
  priority     EmergencyPriority @default(MEDIUM)
  status       EmergencyStatus   @default(OPEN)
  resolutionAction EmergencyAction?
  decidedAt    DateTime?
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  employeeId   String
  employee     Employee          @relation("EmployeeEmergencies", fields: [employeeId], references: [id], onDelete: Restrict)
  roomId       String?
  room         Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  bookingId    String?
  booking      Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  transferRoomId String?
  transferRoom Room?             @relation("EmergencyTransferRoom", fields: [transferRoomId], references: [id], onDelete: SetNull)
  decidedById  String?
  decidedBy    Employee?         @relation("EmergencyDecisions", fields: [decidedById], references: [id], onDelete: SetNull)

  emailLogs    EmailLog[]

  @@index([employeeId])
  @@index([roomId])
  @@index([bookingId])
  @@index([bookingId, status])
  @@index([decidedById])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("emergency_requests")
}

model EmailLog {
  id          String      @id @default(uuid())
  type        EmailType
  status      EmailStatus @default(PENDING)
  toEmail     String
  subject     String
  resendId    String?
  errorMessage String?
  sentAt      DateTime?
  createdAt   DateTime    @default(now())

  employeeId         String?
  employee           Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  bookingId          String?
  booking            Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  emergencyRequestId String?
  emergencyRequest   EmergencyRequest? @relation(fields: [emergencyRequestId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([bookingId])
  @@index([emergencyRequestId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("email_logs")
}

model BookingHistory {
  id         String               @id @default(uuid())
  action     BookingHistoryAction
  metadata   Json?
  note       String?
  createdAt  DateTime             @default(now())

  bookingId  String
  booking    Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      Employee?            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("booking_history")
}
